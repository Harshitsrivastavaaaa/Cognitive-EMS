# Security Settings
# REQUIRED: generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Enables passwordless "Live Demo" login endpoints. Keep false in production.
DEMO_MODE=false

# Database Configuration
# Option 1: SQLite (Default zero-config setup - recommended for quick start)
DATABASE_URL=sqlite:///./employees.db

# Option 2: PostgreSQL (For production or dedicated database servers)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hash_hrms

# Super Admin Credentials (leave blank to disable; use a strong unique password)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Master Approval Admin Credentials (leave blank to disable)
APPROVAL_ADMIN_EMAIL=
APPROVAL_ADMIN_PASSWORD=
