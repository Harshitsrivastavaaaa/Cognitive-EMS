{
    "name": "hrms-ai-desktop",
    "type": "module",
    "private": true,
    "version": "1.0.0",
    "description": "AI-Powered HR Management System - Desktop Application",
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "electron": "electron .",
        "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
        "electron:build": "npm run build && electron-builder",
        "lint": "eslint src --ext js,jsx"
    },
    "dependencies": {
        "@hello-pangea/dnd": "^16.5.0",
        "@hookform/resolvers": "^5.4.0",
        "axios": "^1.21.0",
        "date-fns": "^3.0.6",
        "framer-motion": "^10.18.0",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "lucide-react": "^0.294.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.80.0",
        "react-router-dom": "^6.21.0",
        "recharts": "^2.10.3",
        "socket.io-client": "^4.8.3",
        "survey-core": "^2.5.32",
        "survey-creator-react": "^2.5.32",
        "survey-react-ui": "^2.5.32",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.2.1",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.24",
        "concurrently": "^8.2.2",
        "electron": "^28.1.0",
        "electron-builder": "^24.9.1",
        "eslint": "^8.55.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.2.1",
        "vite": "^5.0.8",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.hash.hrms",
        "productName": "HRMS AI",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "win": {
            "target": "nsis"
        },
        "mac": {
            "target": "dmg"
        },
        "linux": {
            "target": "AppImage"
        }
    }
}
